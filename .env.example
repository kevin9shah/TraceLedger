# TraceLedger — copy to .env (gitignored). Never commit real values.
# NEVER put private keys, seed phrases or wallet backups in this or any file (G2).

# --- Blockchain RPC (read-only) ---
# HTTPS JSON-RPC endpoint for the single EVM chain used by the demo.
EVM_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Expected chain id, asserted at startup so a wrong-network RPC fails loudly (P6).
EVM_CHAIN_ID=137
EVM_CHAIN_NAME=polygon-pos

# --- Token allow-list (contract addresses, lowercase; G7) ---
# Authoritative source = the contract address Cake Wallet shows for the token you actually send.
# Verified on-chain by scripts/verify_tokens.py (symbol + decimals read from the contract).
# Polygon PoS has TWO USDC contracts; use whichever Cake Wallet lists for the token you send.
USDC_CONTRACT=0x3c499c542cef5e3811e1192ce70d8cc03d5c3359
USDT_CONTRACT=0xc2132d05d31c914a87c6611c10748aeb04b58e8f

# --- TigerGraph Savanna ---
# Savanna authenticates with a DATABASE SECRET (no username/password). Create one in the
# workspace's GraphStudio / GSQL: CREATE SECRET, or the Admin > secrets screen.
# Find the host via the workspace's Connect > Connect from API, or take it from the GraphStudio
# URL in your browser. pyTigerGraph >=2.0 requires a scheme; a bare hostname is accepted here and
# https:// is added for you.
#   https://abc123.i.tgcloud.io   <- preferred
#   abc123.i.tgcloud.io           <- also fine, normalised to https://
TG_HOST=
TG_GRAPH=TraceLedger
TG_SECRET=
# Only for a self-hosted / local TigerGraph instead of Savanna:
TG_USERNAME=
TG_PASSWORD=

# --- LLM (hosted API) ---
# Pick ONE provider. Only that provider's key is read, so a leftover key for another provider
# cannot be used by accident.
#   openai -> OPENAI_API_KEY   (paid keys have high rate limits)
#   gemini -> GOOGLE_API_KEY   (free tier is 5 requests/MINUTE -- see RISKS.md S22)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Set to a cheap chat model, e.g. gpt-4o-mini. Confirm the id against the provider's model list
# rather than trusting a remembered string (D35).


# --- App ---
TRACELEDGER_DB=data/traceledger.sqlite
